        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez jamais le pot dans l'eau stagnante."
          }
        }
      }
    },
    "Refresh the top few centimetres yearly; repot when roots circle the pot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die oberen Zentimeter jährlich erneuern; umtopfen, wenn Wurzeln den Topf umkreisen."
