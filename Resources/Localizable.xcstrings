    "Rotate a quarter turn weekly so leaves fill evenly. Keep back from unshaded southern glass — direct midday light scorches broad blades.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wöchentlich eine Vierteldrehung, damit Blätter gleichmäßig wachsen. Abstand zu ungefilterter Südsonne — Mittagssonne verbrennt breite Blätter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez d'un quart chaque semaine pour une croissance uniforme. Évitez le verre sud sans ombre — le midi brûle les grandes feuilles."
          }
        }
      }
    },
    "Never let the pot sit in standing water.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
